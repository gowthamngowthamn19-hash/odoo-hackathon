<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_eco_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.eco.ai</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="EcoSphere AI" string="EcoSphere AI" name="eco_ai" groups="eco_base.group_eco_administrator">
                    <block title="Groq API Configuration">
                        <setting string="Groq API Key" help="Enter your Groq API Key">
                            <field name="eco_groq_api_key" password="True"/>
                        </setting>
                        <setting string="Model Name" help="Default: llama-3.1-8b-instant">
                            <field name="eco_ai_model"/>
                        </setting>
                        <setting string="Temperature" help="Higher values make output more random">
                            <field name="eco_ai_temperature"/>
                        </setting>
                        <setting string="Max Tokens">
                            <field name="eco_ai_max_tokens"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_eco_ai_config_settings" model="ir.actions.act_window">
        <field name="name">AI Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_eco_ai"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'eco_ai', 'bin_size': False}</field>
    </record>
</odoo>
