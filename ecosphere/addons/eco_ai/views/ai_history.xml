<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_ai_usage_tree" model="ir.ui.view">
        <field name="name">eco.ai.usage.tree</field>
        <field name="model">eco.ai.usage</field>
        <field name="arch" type="xml">
            <list string="AI Usage Logs" create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="prompt_tokens"/>
                <field name="completion_tokens"/>
                <field name="total_tokens"/>
                <field name="latency"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
            </list>
        </field>
    </record>

    <record id="action_eco_ai_usage" model="ir.actions.act_window">
        <field name="name">AI Usage Analytics</field>
        <field name="res_model">eco.ai.usage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_eco_ai_prompt_tree" model="ir.ui.view">
        <field name="name">eco.ai.prompt.tree</field>
        <field name="model">eco.ai.prompt</field>
        <field name="arch" type="xml">
            <list string="AI Prompts">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <record id="view_eco_ai_prompt_form" model="ir.ui.view">
        <field name="name">eco.ai.prompt.form</field>
        <field name="model">eco.ai.prompt</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="system_prompt"/>
                        <field name="user_prompt_template"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eco_ai_prompt" model="ir.actions.act_window">
        <field name="name">AI Prompts</field>
        <field name="res_model">eco.ai.prompt</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
