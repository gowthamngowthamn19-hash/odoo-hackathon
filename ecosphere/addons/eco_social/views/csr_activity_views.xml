<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_csr_activity_tree" model="ir.ui.view">
        <field name="name">eco.csr.activity.tree</field>
        <field name="model">eco.csr.activity</field>
        <field name="arch" type="xml">
            <list string="CSR Activities">
                <field name="name"/>
                <field name="location"/>
                <field name="start_date"/>
                <field name="volunteer_hours_awarded"/>
                <field name="status" widget="badge" decoration-info="status == 'published'" decoration-success="status == 'active'" decoration-muted="status in ('completed', 'archived')"/>
            </list>
        </field>
    </record>

    <record id="view_eco_csr_activity_form" model="ir.ui.view">
        <field name="name">eco.csr.activity.form</field>
        <field name="model">eco.csr.activity</field>
        <field name="arch" type="xml">
            <form string="CSR Activity">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="status != 'published'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="status != 'active'"/>
                    <button name="action_archive" string="Archive" type="object" invisible="status not in ('draft', 'completed')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,published,active,completed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="status != 'archived'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Beach Cleanup"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="volunteer_hours_awarded"/>
                            <field name="reward_points"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Details of the activity..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_csr_activity" model="ir.actions.act_window">
        <field name="name">CSR Activities</field>
        <field name="res_model">eco.csr.activity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
