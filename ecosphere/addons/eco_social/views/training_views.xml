<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Social Training -->
    <record id="view_eco_social_training_tree" model="ir.ui.view">
        <field name="name">eco.social.training.tree</field>
        <field name="model">eco.social.training</field>
        <field name="arch" type="xml">
            <list string="ESG Social Training">
                <field name="name"/>
                <field name="category"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_eco_social_training_form" model="ir.ui.view">
        <field name="name">eco.social.training.form</field>
        <field name="model">eco.social.training</field>
        <field name="arch" type="xml">
            <form string="ESG Social Training">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Training Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="category"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_social_training" model="ir.actions.act_window">
        <field name="name">ESG Trainings</field>
        <field name="res_model">eco.social.training</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Training Completion -->
    <record id="view_eco_social_training_completion_tree" model="ir.ui.view">
        <field name="name">eco.social.training.completion.tree</field>
        <field name="model">eco.social.training.completion</field>
        <field name="arch" type="xml">
            <list string="Training Completions">
                <field name="employee_id"/>
                <field name="training_id"/>
                <field name="completion_date"/>
                <field name="status" widget="badge" decoration-success="status == 'verified'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_social_training_completion_form" model="ir.ui.view">
        <field name="name">eco.social.training.completion.form</field>
        <field name="model">eco.social.training.completion</field>
        <field name="arch" type="xml">
            <form string="Training Completion">
                <header>
                    <button name="action_verify" string="Verify" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,verified"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="training_id"/>
                            <field name="completion_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_social_training_completion" model="ir.actions.act_window">
        <field name="name">Training Completions</field>
        <field name="res_model">eco.social.training.completion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
