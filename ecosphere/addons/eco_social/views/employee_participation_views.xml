<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_employee_participation_tree" model="ir.ui.view">
        <field name="name">eco.employee.participation.tree</field>
        <field name="model">eco.employee.participation</field>
        <field name="arch" type="xml">
            <list string="Employee Participations">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="activity_id"/>
                <field name="hours_credited" sum="Total Hours"/>
                <field name="status" widget="badge" decoration-info="status == 'joined'" decoration-warning="status == 'proof_submitted'" decoration-success="status == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_employee_participation_form" model="ir.ui.view">
        <field name="name">eco.employee.participation.form</field>
        <field name="model">eco.employee.participation</field>
        <field name="arch" type="xml">
            <form string="Employee Participation">
                <header>
                    <button name="action_submit_proof" string="Submit Proof" type="object" class="oe_highlight" invisible="status != 'joined'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="status != 'proof_submitted'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="status not in ('joined', 'proof_submitted')"/>
                    <field name="status" widget="statusbar" statusbar_visible="joined,proof_submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="activity_id"/>
                        </group>
                        <group>
                            <field name="hours_credited"/>
                            <field name="proof_attachment" widget="binary" filename="proof_name"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_employee_participation" model="ir.actions.act_window">
        <field name="name">Employee Participations</field>
        <field name="res_model">eco.employee.participation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
