<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_report_definition_form" model="ir.ui.view">
        <field name="name">eco.report.definition.form</field>
        <field name="model">eco.report.definition</field>
        <field name="arch" type="xml">
            <form string="Report Definition">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Executive ESG Report"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider_id"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="export_formats"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="schedule_enabled" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Security">
                            <field name="allowed_roles" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eco_report_definition_tree" model="ir.ui.view">
        <field name="name">eco.report.definition.tree</field>
        <field name="model">eco.report.definition</field>
        <field name="arch" type="xml">
            <list string="Report Definitions">
                <field name="name"/>
                <field name="provider_id"/>
                <field name="export_formats"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_eco_report_definition" model="ir.actions.act_window">
        <field name="name">Report Definitions</field>
        <field name="res_model">eco.report.definition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
