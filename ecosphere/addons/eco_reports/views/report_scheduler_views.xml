<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_report_scheduler_tree" model="ir.ui.view">
        <field name="name">eco.report.scheduler.tree</field>
        <field name="model">eco.report.scheduler</field>
        <field name="arch" type="xml">
            <list string="Scheduled Reports">
                <field name="name"/>
                <field name="report_definition_id"/>
                <field name="frequency"/>
                <field name="next_execution"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_eco_report_scheduler" model="ir.actions.act_window">
        <field name="name">Scheduled Reports</field>
        <field name="res_model">eco.report.scheduler</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
