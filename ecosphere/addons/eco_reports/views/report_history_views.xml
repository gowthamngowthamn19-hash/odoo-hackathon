<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_report_history_tree" model="ir.ui.view">
        <field name="name">eco.report.history.tree</field>
        <field name="model">eco.report.history</field>
        <field name="arch" type="xml">
            <list string="Report History" create="false" edit="false">
                <field name="report_name"/>
                <field name="generated_at"/>
                <field name="generated_by"/>
                <field name="format"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'"/>
                <field name="execution_time"/>
            </list>
        </field>
    </record>

    <record id="action_eco_report_history" model="ir.actions.act_window">
        <field name="name">Report History</field>
        <field name="res_model">eco.report.history</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
