<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_emission_factor_tree" model="ir.ui.view">
        <field name="name">eco.emission.factor.tree</field>
        <field name="model">eco.emission.factor</field>
        <field name="arch" type="xml">
            <list string="Emission Factors">
                <field name="name"/>
                <field name="category"/>
                <field name="unit"/>
                <field name="factor"/>
                <field name="effective_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_eco_emission_factor_form" model="ir.ui.view">
        <field name="name">eco.emission.factor.form</field>
        <field name="model">eco.emission.factor</field>
        <field name="arch" type="xml">
            <form string="Emission Factor">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Electricity"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="unit"/>
                            <field name="factor"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="effective_date"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_eco_emission_factor_search" model="ir.ui.view">
        <field name="name">eco.emission.factor.search</field>
        <field name="model">eco.emission.factor</field>
        <field name="arch" type="xml">
            <search string="Emission Factors">
                <field name="name"/>
                <field name="category"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eco_emission_factor" model="ir.actions.act_window">
        <field name="name">Emission Factors</field>
        <field name="res_model">eco.emission.factor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eco_emission_factor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first emission factor!
            </p>
        </field>
    </record>
</odoo>
