<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_compliance_issue_tree" model="ir.ui.view">
        <field name="name">eco.compliance.issue.tree</field>
        <field name="model">eco.compliance.issue</field>
        <field name="arch" type="xml">
            <list string="Compliance Issues">
                <field name="name"/>
                <field name="department_id"/>
                <field name="owner_id"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-info="severity == 'medium'" decoration-muted="severity == 'low'"/>
                <field name="due_date"/>
                <field name="status" widget="badge" decoration-success="status == 'resolved'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_compliance_issue_form" model="ir.ui.view">
        <field name="name">eco.compliance.issue.form</field>
        <field name="model">eco.compliance.issue</field>
        <field name="arch" type="xml">
            <form string="Compliance Issue">
                <header>
                    <button name="action_assign" string="Assign" type="object" class="oe_highlight" invisible="status != 'open'"/>
                    <button name="action_start" string="Start Work" type="object" class="oe_highlight" invisible="status != 'assigned'"/>
                    <button name="action_resolve" string="Resolve" type="object" class="oe_highlight" invisible="status != 'in_progress'"/>
                    <button name="action_close" string="Close" type="object" invisible="status != 'resolved'"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,assigned,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Issue Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="owner_id"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_compliance_issue" model="ir.actions.act_window">
        <field name="name">Compliance Issues</field>
        <field name="res_model">eco.compliance.issue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
