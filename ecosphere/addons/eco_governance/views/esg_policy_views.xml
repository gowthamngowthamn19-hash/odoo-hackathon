<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_esg_policy_tree" model="ir.ui.view">
        <field name="name">eco.esg.policy.tree</field>
        <field name="model">eco.esg.policy</field>
        <field name="arch" type="xml">
            <list string="ESG Policies">
                <field name="policy_code"/>
                <field name="name"/>
                <field name="category" widget="badge" decoration-success="category == 'environmental'" decoration-info="category == 'social'" decoration-primary="category == 'governance'"/>
                <field name="version"/>
                <field name="effective_date"/>
                <field name="attachment_filename" string="Document"/>
                <field name="status" widget="badge" decoration-info="status == 'review'" decoration-success="status == 'published'" decoration-muted="status == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_esg_policy_form" model="ir.ui.view">
        <field name="name">eco.esg.policy.form</field>
        <field name="model">eco.esg.policy</field>
        <field name="arch" type="xml">
            <form string="ESG Policy">
                <header>
                    <button name="action_review" string="Submit for Review" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_publish" string="Publish" type="object" class="oe_highlight" invisible="status != 'review'"/>
                    <button name="action_archive" string="Archive" type="object" invisible="status not in ('draft', 'published')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,review,published,archived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="status != 'archived'"/>
                    <div class="oe_title">
                        <label for="name" string="Policy Title"/>
                        <h1>
                            <field name="name" placeholder="Policy Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="effective_date"/>
                            <field name="attachment_filename" invisible="1"/>
                            <field name="attachment_file" filename="attachment_filename" widget="binary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Policy Document Content">
                            <field name="description" placeholder="Paste or view full policy text here..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_esg_policy" model="ir.actions.act_window">
        <field name="name">ESG Policies</field>
        <field name="res_model">eco.esg.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
