<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_esg_audit_tree" model="ir.ui.view">
        <field name="name">eco.esg.audit.tree</field>
        <field name="model">eco.esg.audit</field>
        <field name="arch" type="xml">
            <list string="ESG Audits">
                <field name="name"/>
                <field name="department_id"/>
                <field name="start_date"/>
                <field name="status" widget="badge" decoration-info="status == 'scheduled'" decoration-warning="status == 'in_progress'" decoration-success="status == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_esg_audit_form" model="ir.ui.view">
        <field name="name">eco.esg.audit.form</field>
        <field name="model">eco.esg.audit</field>
        <field name="arch" type="xml">
            <form string="ESG Audit">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_start" string="Start Audit" type="object" class="oe_highlight" invisible="status != 'scheduled'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="status != 'in_progress'"/>
                    <button name="action_close" string="Close" type="object" invisible="status != 'completed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Audit Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="auditor_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Findings">
                            <field name="findings" placeholder="Audit findings and notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_esg_audit" model="ir.actions.act_window">
        <field name="name">ESG Audits</field>
        <field name="res_model">eco.esg.audit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
