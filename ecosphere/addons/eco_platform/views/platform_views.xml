<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_eco_platform" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.eco.platform</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="EcoSphere Platform" string="EcoSphere Platform" name="eco_platform" groups="eco_base.group_eco_administrator">
                    <block title="Infrastructure Configuration">
                        <setting string="Cache TTL" help="Time to live for in-memory cache objects (seconds)">
                            <field name="eco_platform_cache_ttl"/>
                        </setting>
                        <setting string="Enable System Monitoring" help="Track API latency and errors">
                            <field name="eco_platform_enable_monitoring"/>
                        </setting>
                        <setting string="Audit Log Retention" help="Days to keep audit logs before archiving">
                            <field name="eco_platform_log_retention"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_eco_platform_config_settings" model="ir.actions.act_window">
        <field name="name">Platform Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_eco_platform"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'eco_platform', 'bin_size': False}</field>
    </record>
</odoo>
