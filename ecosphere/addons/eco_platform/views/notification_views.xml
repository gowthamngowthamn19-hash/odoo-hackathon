<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_notification_template_tree" model="ir.ui.view">
        <field name="name">eco.notification.template.tree</field>
        <field name="model">eco.notification.template</field>
        <field name="arch" type="xml">
            <list string="Notification Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="channel"/>
            </list>
        </field>
    </record>

    <record id="action_eco_notification_template" model="ir.actions.act_window">
        <field name="name">Notification Templates</field>
        <field name="res_model">eco.notification.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
