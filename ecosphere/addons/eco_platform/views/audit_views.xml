<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_audit_log_tree" model="ir.ui.view">
        <field name="name">eco.audit.log.tree</field>
        <field name="model">eco.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Logs" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="module_name"/>
                <field name="action"/>
                <field name="user_id"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
            </list>
        </field>
    </record>

    <record id="action_eco_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">eco.audit.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
