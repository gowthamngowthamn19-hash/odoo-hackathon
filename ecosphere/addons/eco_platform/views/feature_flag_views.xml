<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_feature_flag_tree" model="ir.ui.view">
        <field name="name">eco.feature.flag.tree</field>
        <field name="model">eco.feature.flag</field>
        <field name="arch" type="xml">
            <list string="Feature Flags" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_eco_feature_flag" model="ir.actions.act_window">
        <field name="name">Feature Flags</field>
        <field name="res_model">eco.feature.flag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
