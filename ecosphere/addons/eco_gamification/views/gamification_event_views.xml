<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_gamification_event_tree" model="ir.ui.view">
        <field name="name">eco.gamification.event.tree</field>
        <field name="model">eco.gamification.event</field>
        <field name="arch" type="xml">
            <list string="Gamification Events" decoration-muted="status=='processed'" decoration-danger="status=='failed'">
                <field name="created_date"/>
                <field name="event_code"/>
                <field name="employee_id"/>
                <field name="reference_model"/>
                <field name="status" widget="badge" decoration-warning="status=='pending'" decoration-success="status=='processed'" decoration-danger="status=='failed'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_gamification_event_search" model="ir.ui.view">
        <field name="name">eco.gamification.event.search</field>
        <field name="model">eco.gamification.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="event_code"/>
                <field name="employee_id"/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Event Code" name="group_code" context="{'group_by':'event_code'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Employee" name="group_emp" context="{'group_by':'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eco_gamification_event" model="ir.actions.act_window">
        <field name="name">Gamification Events</field>
        <field name="res_model">eco.gamification.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
