<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_xp_transaction_search" model="ir.ui.view">
        <field name="name">eco.xp.transaction.search</field>
        <field name="model">eco.xp.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="reason"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_emp" context="{'group_by':'employee_id'}"/>
                    <filter string="Transaction Type" name="group_type" context="{'group_by':'transaction_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_eco_xp_transaction" model="ir.actions.act_window">
        <field name="name">XP Transactions</field>
        <field name="res_model">eco.xp.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
