<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_challenge_participation_tree" model="ir.ui.view">
        <field name="name">eco.challenge.participation.tree</field>
        <field name="model">eco.challenge.participation</field>
        <field name="arch" type="xml">
            <list string="Participations">
                <field name="challenge_id"/>
                <field name="employee_id"/>
                <field name="progress" widget="progressbar"/>
                <field name="status" widget="badge" decoration-success="status == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_challenge_participation_search" model="ir.ui.view">
        <field name="name">eco.challenge.participation.search</field>
        <field name="model">eco.challenge.participation</field>
        <field name="arch" type="xml">
            <search string="Participations">
                <field name="employee_id"/>
                <field name="challenge_id"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_emp" context="{'group_by':'employee_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Challenge" name="group_chal" context="{'group_by':'challenge_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eco_challenge_participation_form" model="ir.ui.view">
        <field name="name">eco.challenge.participation.form</field>
        <field name="model">eco.challenge.participation</field>
        <field name="arch" type="xml">
            <form string="Participation">
                <header>
                    <button name="action_in_progress" string="Mark In Progress" type="object" class="oe_highlight" invisible="status != 'joined'"/>
                    <button name="action_submit_proof" string="Submit Proof" type="object" class="oe_highlight" invisible="status != 'in_progress'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="status != 'proof_submitted'"/>
                    <field name="status" widget="statusbar" statusbar_visible="joined,in_progress,proof_submitted,approved,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="challenge_id"/>
                            <field name="employee_id"/>
                            <field name="progress" widget="percentage"/>
                        </group>
                        <group>
                            <field name="joined_date"/>
                            <field name="proof_attachment" widget="binary"/>
                            <field name="proof_notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eco_challenge_participation" model="ir.actions.act_window">
        <field name="name">Participations</field>
        <field name="res_model">eco.challenge.participation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
