<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_leaderboard_tree" model="ir.ui.view">
        <field name="name">eco.leaderboard.tree</field>
        <field name="model">eco.leaderboard</field>
        <field name="arch" type="xml">
            <list string="Leaderboard" default_order="rank asc" create="false" edit="false" delete="false">
                <field name="rank"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="total_xp"/>
                <field name="completed_challenges"/>
                <field name="badge_count"/>
            </list>
        </field>
    </record>

    <record id="action_eco_leaderboard" model="ir.actions.act_window">
        <field name="name">Leaderboard</field>
        <field name="res_model">eco.leaderboard</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
