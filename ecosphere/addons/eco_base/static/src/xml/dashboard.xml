<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="eco_base.Dashboard" owl="1">
        <div class="o_action_manager" style="background-color: #f9fafb; min-height: 100vh;">
            <div class="container-fluid py-4 px-5">
                <h2 class="mb-4 text-primary fw-bold">EcoSphere ESG Dashboard</h2>
                <div class="row">
                    <!-- Cards -->
                    <div class="col-md-3 mb-4">
                        <div class="card text-white shadow-sm border-0" style="background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);">
                            <div class="card-body">
                                <h6 class="text-uppercase fw-bold opacity-75">Overall ESG</h6>
                                <h2 class="display-4 fw-bold mb-0">A-</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="card text-white shadow-sm border-0" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                            <div class="card-body">
                                <h6 class="text-uppercase fw-bold opacity-75">Environmental</h6>
                                <h2 class="display-4 fw-bold mb-0">85<span class="fs-4">/100</span></h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="card text-white shadow-sm border-0" style="background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%);">
                            <div class="card-body">
                                <h6 class="text-uppercase fw-bold opacity-75">Social</h6>
                                <h2 class="display-4 fw-bold mb-0">92<span class="fs-4">/100</span></h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="card text-white shadow-sm border-0" style="background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);">
                            <div class="card-body">
                                <h6 class="text-uppercase fw-bold opacity-75">Governance</h6>
                                <h2 class="display-4 fw-bold mb-0">88<span class="fs-4">/100</span></h2>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold py-3">Recent Activity</div>
                            <div class="card-body">
                                <p class="text-muted"><i class="fa fa-clock-o me-2"></i> Jane Doe logged 5 volunteer hours.</p>
                                <hr/>
                                <p class="text-muted"><i class="fa fa-clock-o me-2"></i> Solar panels maintenance completed.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold py-3">Quick Actions</div>
                            <div class="card-body">
                                <button class="btn btn-outline-primary m-1 px-4 py-2"><i class="fa fa-leaf me-2"></i>Log Emissions</button>
                                <button class="btn btn-outline-success m-1 px-4 py-2"><i class="fa fa-heart me-2"></i>Submit CSR</button>
                                <button class="btn btn-outline-info m-1 px-4 py-2"><i class="fa fa-file-text me-2"></i>Audit Policy</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12 mb-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white fw-bold py-3">Department Rankings</div>
                            <div class="card-body">
                                <p class="text-muted">Placeholder for department leaderboard based on ESG scores.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
