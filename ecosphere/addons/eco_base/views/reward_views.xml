<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_reward_tree" model="ir.ui.view">
        <field name="name">eco.reward.tree</field>
        <field name="model">eco.reward</field>
        <field name="arch" type="xml">
            <tree string="Rewards">
                <field name="name"/>
                <field name="points_required"/>
                <field name="stock"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'archived'"/>
            </tree>
        </field>
    </record>

    <record id="view_eco_reward_form" model="ir.ui.view">
        <field name="name">eco.reward.form</field>
        <field name="model">eco.reward</field>
        <field name="arch" type="xml">
            <form string="Reward">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Reward Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="points_required"/>
                            <field name="stock"/>
                        </group>
                        <group>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_reward" model="ir.actions.act_window">
        <field name="name">Rewards</field>
        <field name="res_model">eco.reward</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_eco_gamification_reward" name="Rewards" parent="menu_eco_gamification" action="action_eco_reward" sequence="20"/>
</odoo>
