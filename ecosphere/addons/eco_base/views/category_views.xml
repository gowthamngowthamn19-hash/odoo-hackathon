<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eco_category_tree" model="ir.ui.view">
        <field name="name">eco.category.tree</field>
        <field name="model">eco.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
                <field name="type"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_eco_category_form" model="ir.ui.view">
        <field name="name">eco.category.form</field>
        <field name="model">eco.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_eco_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">eco.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_eco_category" name="Categories" parent="menu_eco_settings_root" action="action_eco_category" sequence="10"/>
</odoo>
